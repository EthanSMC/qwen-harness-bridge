DATABASE_URL=postgresql://qhb:qhb@localhost:5432/qhb
PORT=8080
HOST=0.0.0.0
DB_POOL_MAX=10

# Bind the MCP credential to the single configured owner. Use a random value
# with at least 32 characters in non-development environments.
QHB_OWNER_ID=owner-1
QHB_MCP_BEARER_TOKEN=replace-with-a-random-32-character-minimum-token

# Application-level key material for encrypting request bodies before they are
# persisted. Keep this out of source control and rotate it through operations.
QHB_REQUEST_ENCRYPTION_KEY=replace-with-application-managed-key-material

# Separate HMAC key for short-lived Connector session tokens. Do not reuse the
# MCP bearer credential or request-encryption key.
QHB_CONNECTOR_SESSION_SIGNING_KEY=replace-with-a-separate-random-32-character-minimum-key
